# Included demo application defaults. Set USE_DEMO_SERVER=false for your application.
USE_DEMO_SERVER=true
BASE_URL=http://127.0.0.1:4173
API_BASE_URL=http://127.0.0.1:4173/api/

# Demo credentials. Replace with dedicated, least-privilege test credentials for your app.
TEST_USER_EMAIL=demo@example.com
TEST_USER_PASSWORD=ChangeMe123!

# Path to the generated Playwright storage-state file. Keep it out of version control.
AUTH_STATE_PATH=.auth/user.json

