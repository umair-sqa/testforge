{
  "name": "testforge-playwright-starter",
  "version": "0.3.0",
  "description": "A professional TypeScript Playwright framework starter with authentication, UI/API examples, demo storefront, diagnostics and CI.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node scripts/demo-server.mjs",
    "verify": "npm run validate && npm test",
    "test:regression": "playwright test --grep-invert @smoke",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "test:auth": "playwright test --project=setup",
    "smoke:demo": "node scripts/smoke-demo.mjs",
    "verify:demo": "npm run smoke:demo && npm run validate && npm test",
    "test:shop": "playwright test --grep \"Demo shop|Shop API\""
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.15.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  },
  "private": true,
  "license": "UNLICENSED"
}
